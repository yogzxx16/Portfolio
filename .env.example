# ==============================================================================
# RESEND & CONTACT FORM ENVIRONMENT VARIABLES
# ==============================================================================
# For local testing, copy this file to .env.local:
#   cp .env.example .env.local
# In Vercel, set these in Project Settings > Environment Variables.
# NEVER commit .env.local or real keys to version control.
# ==============================================================================

# Resend API Key (starts with re_...)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# Destination email where you want to receive portfolio contact submissions
# Example: your-name@gmail.com
CONTACT_TO_EMAIL=

# Sender email address configured in Resend
# For testing with Resend sandbox: onboarding@resend.dev
# For verified custom domain: Portfolio Contact <contact@yourdomain.com>
CONTACT_FROM_EMAIL=

# Optional: Upstash Redis credentials for persistent distributed rate-limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
