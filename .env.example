# ==============================================================================
# YOGESH - PORTFOLIO SERVERLESS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local testing with Vercel CLI (`vercel dev`)
# In Vercel production, configure these variables in the Project Settings > Environment Variables.
# NEVER commit production API keys or tokens to version control.
# ==============================================================================

# Resend API Key for sending emails via /api/contact
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Destination email where contact inquiries should be delivered
# Example: syogeshkumar2020@gmail.com
CONTACT_TO_EMAIL=syogeshkumar2020@gmail.com

# Verified sender email address in Resend (e.g. contact@yourdomain.com or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Upstash Redis REST Credentials for distributed persistent rate limiting
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
